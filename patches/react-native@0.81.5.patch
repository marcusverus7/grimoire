diff --git a/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm b/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm
index 2a677974ca8a929849109f294bddcb239bb202d0..cae4e40dd06c6d18944eb755026ccb9a32746014 100644
--- a/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm
+++ b/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm
@@ -435,7 +435,28 @@ void ObjCTurboModule::performVoidMethodInvocation(
     @try {
       [inv invokeWithTarget:strongModule];
     } @catch (NSException *exception) {
-      throw convertNSExceptionToJSError(runtime, exception, std::string{moduleName}, methodNameStr);
+      // GRIMOIRE PATCH — upstream facebook/react-native#54859 (affects 0.81.5).
+      //
+      // On iOS 26 some native modules throw NSExceptions during launch that they
+      // did not throw on earlier iOS versions. For the ASYNC void path, this
+      // block is dispatched onto a background queue by invokeAsync (see the
+      // nativeMethodCallInvoker_->invokeAsync call below), so a rethrown C++
+      // exception has no handler on that thread: it unwinds to std::terminate()
+      // and abort()s the process — the app dies on launch with SIGABRT.
+      //
+      // Void methods return nothing to JS, so there is no result to poison: the
+      // exception can be logged loudly instead of killing the app. The
+      // synchronous path still throws, because there the caller can catch it.
+      if (shouldVoidMethodsExecuteSync_) {
+        throw convertNSExceptionToJSError(runtime, exception, std::string{moduleName}, methodNameStr);
+      }
+      RCTLogError(
+          @"[TurboModule] Uncaught NSException in async void method %s.%s — %@: %@. Suppressed to "
+           "avoid an uncatchable crash on the module queue (react-native#54859).",
+          moduleName,
+          methodNameStr.c_str(),
+          exception.name,
+          exception.reason);
     } @finally {
       [retainedObjectsForInvocation removeAllObjects];
     }
