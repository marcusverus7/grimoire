# Shared token sent to the recap-web /api/generate-recap endpoint as
# x-grimoire-app-token. Must match GRIMOIRE_APP_TOKEN on Vercel. EXPO_PUBLIC_
# vars are inlined into the JS bundle at build time (not a hard secret).
EXPO_PUBLIC_RECAP_APP_TOKEN=generate-a-long-random-string

# Supabase backend. LEAVE BLANK until a real Grimoire project exists — the app
# then runs local-only (guest) and says so, instead of pointing cloud features
# at a dead host. The previously hardcoded project ref did not exist.
# The anon/publishable key is designed to be public; the service_role key must
# NEVER appear here (server-side only, see apps/recap-web/.env.local.example).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
